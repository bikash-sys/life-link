# ==========================================
# LifeLink Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in local values.
# NEVER commit your actual .env file to Git!

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/lifelink_db?schema=public

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_local_env
JWT_EXPIRES_IN=24h

# Frontend Configuration (Client-side Vite variables must prefix with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api
