# ==========================================
# LifeLink Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in local values.
# NEVER commit your actual .env file to Git!

# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/lifelink_db?schema=public

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_local_env
JWT_EXPIRES_IN=24h

# Frontend Configuration (Client-side Vite variables must prefix with VITE_)
VITE_API_BASE_URL=http://localhost:5001/api

# WhatsApp Notification Service (via whatsapp-msg-client)
# Set to 'true' to enable WhatsApp client & notifications (defaults to false)
WHATSAPP_ENABLED=false
# Session profile name (defaults to 'lifelink')
WHATSAPP_SESSION=lifelink
# Directory where authentication credentials will be stored (relative to server root or absolute path)
WHATSAPP_AUTH_DIR=./.wauth
